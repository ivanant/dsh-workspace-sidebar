{
  "name": "dsh-workspace-sidebar",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Gives the DSH right sidebar one shared tab layout per workspace, with a Settings switch and the workspace's first conversation as the shared session.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
